{
  "name": "food-supply-chain",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "pod": "community-solid-server --rootFilePath ./css/root --config ./css/css.json --seedConfig ./css/css-users.json",
    "scratch": "npm run build && node build/scratch.js",
    "scratch:dev": "nodemon --config nodemon.json --exec npm run scratch",
    "flows:create-vc": "npm run build && node build/flows/create-vc.js",
    "flows:add-file-to-solid-pod": "npm run build && node build/flows/add-file-to-solid-pod.js",
    "flows:set-acl": "npm run build && node build/flows/set-acl.js",
    "setup:actor-identities": "npm run build && node build/identity/bind-actor-identities.js",
    "setup:catalog": "npm run build && node build/catalog/publish-catalog.js",
    "setup:discoverability": "npm run build && node build/flows/publish-discoverability-fixtures.js",
    "canon-hash": "npm run build && node build/bc/canon-hash.js",
    "explore": "cd secuweb-anchors && npm run explore",
    "jsonld:expand": "npm run build && node build/jsonld.expand.js",
    "test:readme-setup": "./scripts/test-readme-setup.sh",
    "test:readme-setup:viewer": "./scripts/test-readme-setup.sh --with-viewer",
    "start:viewer": "./scripts/start-viewer.sh",
    "test:scenarios": "npm run build && node build/tests/scenario-tests.js",
    "scenario:ui": "npm run build && node build/tests/scenario-results-server.js",
    "fixtures:validate": "npm run build && node build/fixtures/validate-manifest.js dev/fixtures/product-shipment/manifest.json",
    "fixtures:validate-overlays": "npm run build && node build/fixtures/validate-overlays.js dev/fixtures/product-shipment",
    "setup:fixtures": "npm run build && node build/fixtures/publish-product-shipment-fixtures.js",
    "flows:anchor-fixtures": "npm run build && node build/flows/anchor-fixtures.js"
  },
  "config": {
    "community-solid-server": {
      "port": 3000,
      "loggingLevel": "info"
    }
  },
  "author": "Gertjan De Mulder (gertjan.demulder@ugent.be)",
  "license": "MIT",
  "description": "SecuWeb Demonstrator: Food Supply Chain based on Solid and Blockchain",
  "dependencies": {
    "@digitalbazaar/data-integrity-context": "^2.0.1",
    "@digitalcredentials/rdf-canonize": "^1.0.0",
    "@inrupt/solid-client": "^2.1.2",
    "@inrupt/solid-client-authn-core": "^3.1.0",
    "@inrupt/universal-fetch": "^1.0.3",
    "@sinclair/typebox": "^0.34.41",
    "commander": "^14.0.1",
    "credentials-context": "^2.0.0",
    "did-context": "^3.1.1",
    "json-schema-to-ts": "^3.1.1",
    "jsonld": "^8.3.3",
    "jsonld-document-loader": "^2.3.0"
  },
  "devDependencies": {
    "@comunica/query-sparql": "2.10.2",
    "@solid/community-server": "^7.1.7",
    "@types/jsonld": "^1.5.15",
    "@types/node": "^24.5.2",
    "nodemon": "^3.1.10",
    "typescript": "^5.9.2"
  }
}
