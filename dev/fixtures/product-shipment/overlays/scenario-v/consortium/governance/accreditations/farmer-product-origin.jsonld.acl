@prefix acl: <http://www.w3.org/ns/auth/acl#>.

<#owner>
    a acl:Authorization;
    acl:accessTo <http://localhost:3000/consortium/governance/accreditations/farmer-product-origin.jsonld>;
    acl:agent <http://localhost:3000/consortium/profile/card#me>;
    acl:mode acl:Read, acl:Write, acl:Control.

<#packager-read>
    a acl:Authorization;
    acl:accessTo <http://localhost:3000/consortium/governance/accreditations/farmer-product-origin.jsonld>;
    acl:agent <http://localhost:3000/packager/profile/card#me>;
    acl:mode acl:Read.
