VC_LIB=${PWD}/vc
ANCHOR_REPO=${PWD}/secuweb-anchors
VC_MODE=solid
VC_CONFIG=${VC_LIB}/test/configs/solid-config.json
VC_UNSIGNED=${VC_LIB}/test/resources/unsigned/alice-university.jsonld
VC_OUT=${PWD}/data/vcs/alice-university-vc.jsonld
SUBJECT_DID=did:secuweb:product:batch123
METADATA_URI=

# --- Blockchain anchoring: RPC + per-actor signing -------------------------
# RPC endpoint the anchoring scripts and verifier talk to (dev default below).
RPC_URL=http://127.0.0.1:8545

# Per-actor signing keys (Option A, production). If unset, dev derives each
# actor's signer from the Hardhat default mnemonic by index — see
# secuweb-anchors/scripts/signers.ts. On a real chain set ALL of them together
# (order matters), and fund each address with gas before registering DIDs or
# anchoring credentials.
# ACTOR_PK_CONSORTIUM=0x...
# ACTOR_PK_FARMER=0x...
# ACTOR_PK_PACKAGER=0x...
# ACTOR_PK_TRANSPORTER=0x...
# ACTOR_PK_RETAILER=0x...

# Chain id for the non-dev 'testnet' network, also the eip155:<id> prefix used
# in secuweb-anchors/data/did-docs/*.did.json. Hardhat dev chain id is 31337.
# CHAIN_ID=11155111
